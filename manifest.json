{
  "name": "Jugaadu Flex",
  "description": "A Chrome Extension to make FlexStudent better",
  "manifest_version": 3,
  "version": "2.2.1",
  "permissions": ["scripting", "tabs", "storage"],   
  "host_permissions": ["*://flexstudent.nu.edu.pk/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "favicon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://flexstudent.nu.edu.pk/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
